{
  "name": "interactive-globe-to-map",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "precompute": "node scripts/precompute.js",
    "precompute:etopo": "uv run --with numpy --with pillow --with scipy --with netCDF4 python scripts/precompute-etopo2022.py",
    "precompute:contours": "uv run --with numpy --with pillow python scripts/precompute-contours.py",
    "precompute:contours-ts": "npx tsx scripts/precompute-contours.ts",
    "precompute:vectors": "npx tsx scripts/precompute-vectors.ts",
    "precompute:vectors-10m": "npx tsx scripts/precompute-vectors-10m.ts",
    "precompute:overture-vectors": "npx tsx scripts/precompute-overture-vectors.ts",
    "refresh:planetary": "npx tsx scripts/refresh-planetary-data.ts",
    "refresh:wind": "npx tsx scripts/fetch-or-generate-gfs-wind.ts",
    "refresh:clouds": "npx tsx scripts/fetch-or-generate-gfs-clouds.ts",
    "refresh:radar": "npx tsx scripts/fetch-live-radar.ts",
    "refresh:starlink": "npx tsx scripts/fetch-or-generate-tle-starlink.ts",
    "weather:mock": "uv run --with numpy python scripts/fetch-weathernext3.py --mock --hours 24",
    "weather:dry-run": "uv run --with zarr --with gcsfs --with numpy python scripts/fetch-weathernext3.py --dry-run",
    "weather:fetch": "uv run --with zarr --with gcsfs --with numpy python scripts/fetch-weathernext3.py",
    "weather:doctor": "npx tsx scripts/doctor-weather.ts",
    "lint:wgsl": "node scripts/lint-wgsl-control-flow.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "d3": "^7.9.0",
    "d3-geo-voronoi": "^2.1.0",
    "geojson": "^0.5.0",
    "lucide-react": "^1.39.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^5.0.0",
    "@webgpu/types": "^0.1.72",
    "autoprefixer": "^10.4.19",
    "duckdb": "^1.4.4",
    "duckdb-async": "^1.4.2",
    "happy-dom": "^20.13.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "three": "^0.185.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.11"
  }
}
